{
  "name": "graphoxide-repository-tools",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "prepare": "husky",
    "benchmark:graph-build": "node scripts/benchmark-graph-build.mjs",
    "benchmark:structured-json": "node scripts/benchmark-graph-build.mjs --scenario structured-json",
    "benchmark:structured-containers": "node scripts/benchmark-graph-build.mjs --scenario structured-containers",
    "benchmark:idl-schema": "node scripts/benchmark-graph-build.mjs --scenario idl-schema",
    "benchmark:diagrams": "node scripts/benchmark-graph-build.mjs --scenario diagrams",
    "benchmark:facility-models": "node scripts/benchmark-graph-build.mjs --scenario facility-models",
    "benchmark:openusd-assets": "node scripts/benchmark-graph-build.mjs --scenario openusd-assets",
    "qualification:universal": "node scripts/qualify-universal-indexing.mjs",
    "qualification:ci": "node scripts/qualify-universal-indexing.mjs --profile ci-mixed-v1",
    "test:qualification": "node --test scripts/qualify-universal-indexing.test.mjs",
    "test:benchmark": "node --test scripts/benchmark-graph-build.test.mjs scripts/qualify-universal-indexing.test.mjs",
    "test:workflows": "node --test scripts/workflow-dependencies.test.mjs",
    "test:security": "node --test scripts/security-audit.test.mjs",
    "audit:security": "node scripts/security-audit.mjs",
    "verify:pre-push": "node scripts/verify.mjs --pre-push",
    "verify:release": "node scripts/verify.mjs --release"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "yaml": "^2.9.0"
  }
}
