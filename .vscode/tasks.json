{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Graphoxide: Build CLI",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "--release",
        "--bin",
        "graphoxide"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Graphoxide: Install Extension Dependencies",
      "type": "process",
      "command": "npm",
      "args": [
        "ci"
      ],
      "options": {
        "cwd": "${workspaceFolder}/editors/vscode"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Graphoxide: Check Extension",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}/editors/vscode"
      },
      "problemMatcher": [
        "$tsc"
      ],
      "group": "test",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Graphoxide: Index VS Code Sample",
      "type": "process",
      "command": "${workspaceFolder}/target/release/graphoxide",
      "args": [
        "extract",
        "${workspaceFolder}/examples/vscode-sample",
        "--force"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Graphoxide: Prepare Extension Host",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Graphoxide: Build CLI",
        "Graphoxide: Install Extension Dependencies",
        "Graphoxide: Check Extension",
        "Graphoxide: Index VS Code Sample"
      ],
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
